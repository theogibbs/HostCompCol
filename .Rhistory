legend.position = "top",
text = element_text(size=20),
legend.text=element_text(size = 15),
plot.title.position = "plot",
panel.border = element_rect(colour = "black", fill=NA, linewidth=1))
# loading packages
library(VGAM)
GetSpatialWeights <- function(distances, in_dist, K) {
if(int_dist == "Laplace") {
return(dlaplace(distances, location = 0, scale = K))
} else if(int_dist == "Normal") {
return(dnorm(distances, mean = 0, sd = K))
} else if(int_dist == "Uniform") {
return(dunif(distances, min = -K, max = K))
} else {
return("error")
}
}
GetDispersalDistances <- function(nsamples, in_dist, K) {
if(int_dist == "Laplace") {
return(rlaplace(nsamples, location = 0, scale = K))
} else if(int_dist == "Normal") {
return(rnorm(nsamples, mean = 0, sd = K))
} else if(int_dist == "Uniform") {
return(runif(nsamples, min = -K, max = K))
} else {
return("error")
}
}
# function that calculates fecundity
GetFecundity <- function(state, pars) {
fecs <- with(pars, {
ints <- alpha[,state$SpID]
spatial_ints <- ints[state$SpID,]
dist_mat <- as.matrix(dist(state$x, method = "euclidean"))
spatial_weights <- GetSpatialWeights(distances = dist_mat, in_dist = int_dist, K = K_int)
spatial_effects <- spatial_weights * spatial_ints
fecundity <- lambda[state$SpID] / (1 + rowSums(spatial_effects))
return(fecundity)
})
return(fecs)
}
# function that calculates new seeds
GetNewSeeds <- function(state, fecs) {
new_seeds <- rpois(n = nrow(state), lambda = fecs)
return(new_seeds)
}
DisperseSeeds <- function(state, new_seeds, pars) {
new_state <- data.frame(x = rep(state$x, times = new_seeds),
SpID = rep(state$SpID, times = new_seeds))
new_state$x <- new_state$x + GetDispersalDistances(nrow(new_state), pars$dis_dist, pars$K_dis)
new_state$x <- new_state$x %% pars$max_dist
return(new_state)
}
S <- 3
ini_pop_size <- 100
max_dist <- 50
ini_state <- data.frame(x = runif(ini_pop_size, min = 0, max = max_dist),
SpID = sample(1:S,
size = ini_pop_size,
replace = TRUE))
state <- ini_state
lambda <- rep(10, times = S)
alpha <- 1.5
alpha <- matrix(alpha, nrow = S, ncol = S)
diag(alpha) <- 1
int_dist <- "Laplace"
K_int <- 0.5
dis_dist <- "Laplace"
K_dis <- 0.5
pars <- list(lambda = lambda, alpha = alpha,
int_dist = int_dist, K_int = K_int,
dis_dist = dis_dist, K_dis = K_dis,
max_dist = max_dist)
num_steps <- 2e2
out_data <- state
out_data$Step <- 1
for(cur_step in 2:num_steps) {
fecs <- GetFecundity(state, pars)
new_seeds <- GetNewSeeds(state, fecs)
state <- DisperseSeeds(state, new_seeds, pars)
cur_state <- state
cur_state$Step <- cur_step
out_data <- rbind(out_data, cur_state)
}
ggplot(out_data, aes(x = Step, y = x, width = 1, color = as.factor(SpID))) +
geom_tile(alpha =0.5) + theme_classic() +
theme(
axis.text.x = element_text(angle = 45, vjust = 0.5),
legend.position = "top",
text = element_text(size=20),
legend.text=element_text(size = 15),
plot.title.position = "plot",
panel.border = element_rect(colour = "black", fill=NA, linewidth=1))
summ_data <- out_data %>%
group_by(Step) %>%
count(SpID)
ggplot(summ_data, aes(x = Step, y = n, color = as.factor(SpID))) +
geom_line(size = 1, alpha = 0.75) + theme_classic() +
theme(
axis.text.x = element_text(angle = 45, vjust = 0.5),
legend.position = "top",
text = element_text(size=20),
legend.text=element_text(size = 15),
plot.title.position = "plot",
panel.border = element_rect(colour = "black", fill=NA, linewidth=1))
